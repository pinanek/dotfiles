theme = catppina

# ── Font ──────────────────────────────────────────────────────────────

font-family = Cartograph CF

window-title-font-family = Cartograph CF

font-size = 14
font-feature = ss04
freetype-load-flags = no-hinting,no-force-autohint

font-style = Demi Bold
font-style-bold = Bold
font-style-italic = Demi Bold Italic
font-style-bold-italic = Bold Italic
font-synthetic-style = false

# font-codepoint-map = U+E000-U+E00A,U+E0A0-U+E0A3,U+E0CA,U+E0CC-U+E0D7,U+E200-U+E2A9,U+E300-U+E3E3,U+E5FA-U+E6B7,U+E700-U+E8EF,U+EA60-U+EC1E,U+ED00-U+F2FF,U+EE00-U+EE0B,U+F300-U+F381,U+F400-U+F533,U+F0001-U+F1AF0=Symbols Nerd Font

# ── Window ────────────────────────────────────────────────────────────

# Maximize the window by default
window-height = 10000
window-width = 10000

window-padding-x = 10
window-padding-y = 5

# ── MacOS stuff ───────────────────────────────────────────────────────

macos-titlebar-style = tabs
macos-option-as-alt = true

# ── Other ─────────────────────────────────────────────────────────────

# $TERM
term = xterm-ghostty

shell-integration-features = ssh-terminfo,sudo

copy-on-select = false
