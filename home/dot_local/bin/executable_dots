#!/usr/bin/env bash

set -euo pipefail

catppina_repository='https://github.com/pinanek/catppina.git'

log() {
    printf 'dots: %s\n' "$*"
}

fail() {
    printf 'dots: %s\n' "$*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

copy_theme() {
    local source=$1
    local destination=$2

    [[ -f "$catppina_dir/dist/$source" ]] || fail "theme asset not found: $source"
    mkdir -p "$(dirname "$source_dir/$destination")"
    install -m 0644 "$catppina_dir/dist/$source" "$source_dir/$destination"
}

run_update_step() {
    local description=$1
    shift

    log "$description..."
    if "$@"; then
        return 0
    fi

    failed_updates+=("$description")
    log "failed: $description"
}

update_pnpm_packages() {
    if command -v pnpm >/dev/null 2>&1; then
        run_update_step 'Updating global pnpm packages' pnpm update --global
    else
        log 'Skipping pnpm: command not found.'
    fi
}

update_node() {
    if command -v fnm >/dev/null 2>&1; then
        run_update_step 'Updating Node.js LTS' fnm install --lts
    else
        log 'Skipping fnm: command not found.'
    fi
}

update_rust() {
    if command -v rustup >/dev/null 2>&1; then
        run_update_step 'Updating Rust toolchains' rustup update
    else
        log 'Skipping Rust: rustup not found.'
    fi
}

update_cargo_tools() {
    local source_dir
    local manifest
    local package

    if ! command -v cargo >/dev/null 2>&1; then
        log 'Skipping Cargo tools: cargo not found.'
        return
    fi

    source_dir=$(chezmoi source-path)
    manifest="$source_dir/.chezmoitemplates/tools.cargo"

    if [[ ! -r "$manifest" ]]; then
        log "Skipping Cargo tools manifest: not found at $manifest."
        return
    fi

    while read -r package; do
        [[ -n "$package" && "$package" != \#* ]] || continue
        run_update_step "Upgrading $package with Cargo" \
            cargo install --locked --force "$package"
    done < "$manifest"
}

install_missing_bin_tools() {
    local source_dir
    local manifest
    local source
    local executable
    local asset_pattern

    source_dir=$(chezmoi source-path)
    manifest="$source_dir/.chezmoitemplates/isl-server.bin"

    if [[ ! -r "$manifest" ]]; then
        log "Skipping bin manifest: not found at $manifest."
        return
    fi

    mkdir -p "$HOME/.local/bin"

    while read -r source executable asset_pattern; do
        [[ -n "$source" && -n "$executable" ]] || continue

        if [[ -x "$HOME/.local/bin/$executable" ]]; then
            continue
        fi

        if [[ -n "$asset_pattern" ]]; then
            run_update_step "Installing $executable with bin" \
                bin install --name "$asset_pattern" "$source" "$HOME/.local/bin/$executable"
        else
            run_update_step "Installing $executable with bin" \
                bin install "$source" "$HOME/.local/bin/$executable"
        fi
    done < "$manifest"
}

update_isl_server_packages() {
    local apt_get=(apt-get)

    if [[ "$(uname -s)" != 'Linux' ]]; then
        fail 'the isl-server profile requires Linux'
    fi

    if ! command -v apt-get >/dev/null 2>&1; then
        fail 'apt-get is required for the isl-server profile'
    fi

    if (( EUID != 0 )); then
        require_command sudo
        log 'Requesting sudo access for APT...'
        sudo -v
        apt_get=(sudo apt-get)
    fi

    run_update_step 'Updating Debian package metadata' "${apt_get[@]}" update
    run_update_step 'Upgrading Debian packages' "${apt_get[@]}" upgrade --yes

    if command -v bin >/dev/null 2>&1; then
        install_missing_bin_tools
        run_update_step 'Updating bin-managed tools' bin update
    else
        log 'Skipping bin: command not found.'
    fi

    if command -v uv >/dev/null 2>&1; then
        run_update_step 'Updating uv' uv self update
        run_update_step 'Upgrading uv tools' uv tool upgrade --all
        run_update_step 'Upgrading uv-managed Python versions' uv python upgrade
    else
        log 'Skipping uv: command not found.'
    fi
}

update_pinamac_packages() {
    if [[ "$(uname -s)" != 'Darwin' ]]; then
        fail 'the pinamac profile requires macOS'
    fi

    require_command brew
    run_update_step 'Updating Homebrew metadata' brew update
    run_update_step 'Upgrading Homebrew packages' brew upgrade

    if command -v mas >/dev/null 2>&1; then
        run_update_step 'Upgrading Mac App Store applications' mas upgrade
    else
        log 'Skipping Mac App Store applications: mas not found.'
    fi
}

update_packages() {
    local profile

    profile=$(chezmoi execute-template '{{ .profile }}')
    failed_updates=()

    case "$profile" in
        pinamac) update_pinamac_packages ;;
        isl-server) update_isl_server_packages ;;
        *) fail "unsupported chezmoi profile: $profile" ;;
    esac

    update_pnpm_packages
    update_node
    update_rust
    update_cargo_tools

    if (( ${#failed_updates[@]} )); then
        printf 'dots: package update failed for: %s\n' "${failed_updates[*]}" >&2
        return 1
    fi

    log 'package updates complete.'
}

pull_themes() {
    local profile
    local data_home
    local source_dir

    profile=$(chezmoi execute-template '{{ .profile }}')
    source_dir=$(chezmoi source-path)
    data_home=${XDG_DATA_HOME:-"$HOME/.local/share"}
    catppina_dir="$data_home/catppina"

    if [[ -d "$catppina_dir/.git" ]]; then
        log 'updating Catppina themes...'
        git -C "$catppina_dir" fetch --depth=1 origin main
        git -C "$catppina_dir" reset --hard origin/main
    elif [[ -e "$catppina_dir" ]]; then
        fail "$catppina_dir exists but is not a Git checkout"
    else
        log 'cloning Catppina themes...'
        git clone --depth=1 "$catppina_repository" "$catppina_dir"
    fi

    log 'copying shared themes into chezmoi source state...'
    copy_theme btop/catppina_dark.theme dot_config/btop/themes/catppina_dark.theme
    copy_theme delta/catppina_dark.gitconfig dot_config/delta/catppina_dark.gitconfig
    copy_theme fzf/catppina_dark.sh dot_config/fzf/themes/catppina_dark.zsh
    copy_theme gitui/catppina_dark.ron dot_config/gitui/theme.ron
    copy_theme helix/catppina_dark.toml dot_config/helix/themes/catppina_dark.toml
    copy_theme helix/catppina_light.toml dot_config/helix/themes/catppina_light.toml
    copy_theme posting/catppina_dark.yaml dot_local/share/posting/themes/catppina_dark.yaml
    copy_theme yazi/catppina_dark.toml dot_config/yazi/theme.toml

    if [[ "$profile" == 'pinamac' ]]; then
        log 'copying PinaMac themes into chezmoi source state...'
        copy_theme ghostty/catppina_dark.conf dot_config/ghostty/themes/catppina_dark
        copy_theme zed/catppina_dark.json dot_config/zed/themes/catppina_dark.json
        copy_theme zed/catppina_light.json dot_config/zed/themes/catppina_light.json
    fi

    log 'applying updated source state...'
    chezmoi apply
}

print_zsh_completions() {
    cat <<'ZSH'
_dots() {
  local -a commands

  commands=(
    'pull-themes:Update Catppina themes and apply the chezmoi source state'
    'up-pkgs:Update packages managed by the active profile'
    'completions:Generate shell completions'
  )

  if (( CURRENT == 2 )); then
    _describe -t commands 'dots command' commands
  elif [[ $words[2] == completions ]]; then
    _values 'shell' zsh
  fi
}

compdef _dots dots
ZSH
}

usage() {
    cat <<'USAGE'
Usage: dots <command>

Commands:
  pull-themes      Update Catppina, copy themes into chezmoi source state, and apply them.
  up-pkgs          Update packages managed by the active profile.
  completions zsh  Generate Zsh completions.
USAGE
}

case "${1:-}" in
    pull-themes)
        require_command chezmoi
        require_command git
        require_command install
        pull_themes
        ;;
    up-pkgs)
        require_command chezmoi
        update_packages
        ;;
    completions)
        case "${2:-}" in
            zsh) print_zsh_completions ;;
            *) fail "unsupported completion shell: ${2:-missing}" ;;
        esac
        ;;
    -h | --help | help | '')
        usage
        ;;
    *)
        fail "unknown command: $1"
        ;;
esac
