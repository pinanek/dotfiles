#!/usr/bin/env bash

set -euo pipefail

catppina_repository='https://github.com/pinanek/catppina.git'

log() {
    printf 'dots: %s\n' "$*"
}

fail() {
    printf 'dots: %s\n' "$*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

copy_themes() {
    local source
    local destination

    while read -r source destination; do
        [[ -n "$source" && "$source" != \#* && -n "$destination" ]] || continue
        [[ -f "$catppina_dir/dist/$source" ]] || fail "theme asset not found: $source"
        mkdir -p "$(dirname "$source_dir/$destination")"
        install -m 0644 "$catppina_dir/dist/$source" "$source_dir/$destination"
    done
}

run_update_step() {
    local description=$1
    shift

    log "$description..."
    if "$@"; then
        succeeded_updates=$((succeeded_updates + 1))
        return 0
    fi

    failed_updates+=("$description")
    log "failed: $description"
}

update_pnpm_packages() {
    if command -v pnpm >/dev/null 2>&1; then
        run_update_step 'Updating pnpm' pnpm self-update
        run_update_step 'Updating global pnpm packages' pnpm update --global
    else
        log 'Skipping pnpm: command not found.'
    fi
}

update_fnm() {
    local installed_version
    local latest_version
    local release

    installed_version=$(fnm --version)
    installed_version=${installed_version#fnm }

    if ! release=$(curl -fsSL https://api.github.com/repos/Schniz/fnm/releases/latest); then
        log 'Skipping fnm update: unable to fetch the latest release.'
        return
    fi

    latest_version=$(printf '%s\n' "$release" |
        sed -nE 's/^[[:space:]]*"tag_name":[[:space:]]*"v?([^"]+)".*/\1/p')
    if [[ -z "$latest_version" ]]; then
        log 'Skipping fnm update: latest release has no version tag.'
        return
    fi

    if [[ "$installed_version" == "$latest_version" ]]; then
        log "fnm $installed_version is already the latest version."
        return
    fi

    log "Updating fnm from $installed_version to $latest_version..."
    curl -fsSL https://fnm.vercel.app/install |
        bash -s -- --install-dir "$HOME/.local/bin" --skip-shell --force-install
}

update_node() {
    if command -v fnm >/dev/null 2>&1; then
        run_update_step 'Updating fnm' update_fnm
        run_update_step 'Updating Node.js LTS' fnm install --lts
    else
        log 'Skipping fnm: command not found.'
    fi
}

update_deno() {
    local deno="$HOME/.deno/bin/deno"

    if [[ -x "$deno" ]]; then
        run_update_step 'Updating Deno' "$deno" upgrade
    elif command -v deno >/dev/null 2>&1; then
        run_update_step 'Updating Deno' deno upgrade
    else
        log 'Skipping Deno: command not found.'
    fi
}

update_rust() {
    if command -v rustup >/dev/null 2>&1; then
        run_update_step 'Updating Rust toolchains' rustup update
    else
        log 'Skipping Rust: rustup not found.'
    fi
}

update_helix() {
    local helix_source="${XDG_DATA_HOME:-$HOME/.local/share}/helix/source"
    local cargo="$HOME/.cargo/bin/cargo"
    local hx="$HOME/.cargo/bin/hx"
    local remote_branch
    local current_commit
    local latest_commit

    if [[ ! -d "$helix_source/.git" ]]; then
        log 'Skipping Helix: source checkout not found.'
        return
    fi

    if [[ ! -x "$cargo" ]]; then
        log 'Skipping Helix: cargo not found.'
        return
    fi

    if [[ -n "$(git -C "$helix_source" status --porcelain)" ]]; then
        log 'Skipping Helix: source checkout has local changes.'
        return
    fi

    git -C "$helix_source" fetch --quiet origin
    remote_branch=$(git -C "$helix_source" symbolic-ref --quiet --short refs/remotes/origin/HEAD) || {
        printf 'Unable to determine Helix upstream branch.\n' >&2
        return 1
    }
    current_commit=$(git -C "$helix_source" rev-parse HEAD)
    latest_commit=$(git -C "$helix_source" rev-parse "$remote_branch")

    if [[ "$current_commit" == "$latest_commit" && -x "$hx" ]]; then
        log 'Helix is already at the latest commit.'
        return
    fi

    if [[ "$current_commit" != "$latest_commit" ]]; then
        log 'Updating Helix source...'
        git -C "$helix_source" merge --ff-only "$remote_branch"
    else
        log 'Helix binary is missing; building the current source...'
    fi

    log 'Building and installing Helix...'
    (
        cd "$helix_source"
        env HELIX_DEFAULT_RUNTIME="$helix_source/runtime" \
            "$cargo" install --path helix-term --locked --force
    )
}

update_mitos() {
    local mitos_source="${XDG_DATA_HOME:-$HOME/.local/share}/mitos/source"
    local cargo="$HOME/.cargo/bin/cargo"
    local ms="$HOME/.cargo/bin/ms"
    local remote_branch
    local current_commit
    local latest_commit

    if [[ ! -d "$mitos_source/.git" ]]; then
        log 'Skipping Mitos: source checkout not found.'
        return
    fi

    if [[ ! -x "$cargo" ]]; then
        log 'Skipping Mitos: cargo not found.'
        return
    fi

    if [[ -n "$(git -C "$mitos_source" status --porcelain)" ]]; then
        log 'Skipping Mitos: source checkout has local changes.'
        return
    fi

    git -C "$mitos_source" fetch --quiet origin
    remote_branch=$(git -C "$mitos_source" symbolic-ref --quiet --short refs/remotes/origin/HEAD) || {
        printf 'Unable to determine Mitos upstream branch.\n' >&2
        return 1
    }
    current_commit=$(git -C "$mitos_source" rev-parse HEAD)
    latest_commit=$(git -C "$mitos_source" rev-parse "$remote_branch")

    if [[ "$current_commit" == "$latest_commit" && -x "$ms" ]]; then
        log 'Mitos is already at the latest commit.'
        return
    fi

    if [[ "$current_commit" != "$latest_commit" ]]; then
        log 'Updating Mitos source...'
        git -C "$mitos_source" merge --ff-only "$remote_branch"
    else
        log 'Mitos binary is missing; building the current source...'
    fi

    log 'Building and installing Mitos...'
    env MITOS_DEFAULT_RUNTIME="$mitos_source/runtime" \
        "$cargo" install \
        --profile opt \
        --config 'build.rustflags=["-C", "target-cpu=native"]' \
        --path "$mitos_source/crates/term" \
        --locked \
        --force
}

update_cargo_tools() {
    local source_dir
    local manifest
    local package

    if ! command -v cargo >/dev/null 2>&1; then
        log 'Skipping Cargo tools: cargo not found.'
        return
    fi

    source_dir=$(chezmoi source-path)
    manifest="$source_dir/.chezmoitemplates/tools.cargo"

    if [[ ! -r "$manifest" ]]; then
        log "Skipping Cargo tools manifest: not found at $manifest."
        return
    fi

    while read -r package; do
        [[ -n "$package" && "$package" != \#* ]] || continue
        run_update_step "Upgrading $package with Cargo" \
            cargo install --locked --force "$package"
    done <"$manifest"
}

install_missing_bin_tools() {
    local manifest
    local source
    local executable
    local asset_pattern
    local destination

    manifest="$(chezmoi source-path)/.chezmoitemplates/isl-server.bin"
    if [[ ! -r "$manifest" ]]; then
        log "Skipping bin manifest: not found at $manifest."
        return
    fi

    mkdir -p "$HOME/.local/bin"

    while read -r source executable asset_pattern; do
        [[ -n "$source" && "$source" != \#* && -n "$executable" ]] || continue
        destination="$HOME/.local/bin/$executable"
        [[ -x "$destination" ]] && continue

        if [[ -n "$asset_pattern" ]]; then
            run_update_step "Installing $executable with bin" \
                bin install --name "$asset_pattern" "$source" "$destination"
        else
            run_update_step "Installing $executable with bin" \
                bin install "$source" "$destination"
        fi
    done <"$manifest"
}

update_isl_server_packages() {
    local apt_get=(apt-get)

    if [[ "$(uname -s)" != 'Linux' ]]; then
        fail 'the isl-server profile requires Linux'
    fi

    if ! command -v apt-get >/dev/null 2>&1; then
        fail 'apt-get is required for the isl-server profile'
    fi

    if ((EUID != 0)); then
        require_command sudo
        log 'Requesting sudo access for APT...'
        sudo -v
        apt_get=(sudo apt-get)
    fi

    run_update_step 'Updating Debian package metadata' "${apt_get[@]}" update
    run_update_step 'Upgrading Debian packages' "${apt_get[@]}" upgrade --yes
}

update_uv_tools() {
    if command -v uv >/dev/null 2>&1; then
        run_update_step 'Updating uv' uv self update
        run_update_step 'Upgrading uv tools' uv tool upgrade --all
        run_update_step 'Upgrading uv-managed Python versions' uv python upgrade
        run_update_step 'Setting the default uv Python' uv python install --default
    else
        log 'Skipping uv: command not found.'
    fi
}

update_hax_web() {
    local hax_web_source="${XDG_DATA_HOME:-$HOME/.local/share}/hax-web"

    if [[ ! -d "$hax_web_source/.git" ]]; then
        log 'Skipping hax-web: source checkout not found.'
        return
    fi

    if [[ -n "$(git -C "$hax_web_source" status --porcelain)" ]]; then
        log 'Skipping hax-web: source checkout has local changes.'
        return
    fi

    git -C "$hax_web_source" pull --ff-only || return
    "$hax_web_source/install.sh"
}

update_bin_tools() {
    local profile=$1

    if ! command -v bin >/dev/null 2>&1; then
        log 'Skipping bin: command not found.'
        return
    fi

    if [[ "$profile" == 'isl-server' ]]; then
        install_missing_bin_tools
    fi

    run_update_step 'Updating bin-managed tools' bin update
}

update_pinamac_packages() {
    if [[ "$(uname -s)" != 'Darwin' ]]; then
        fail 'the pinamac profile requires macOS'
    fi

    require_command brew
    run_update_step 'Updating Homebrew metadata' brew update
    run_update_step 'Upgrading Homebrew packages' brew upgrade

    if command -v mas >/dev/null 2>&1; then
        run_update_step 'Upgrading Mac App Store applications' mas upgrade
    else
        log 'Skipping Mac App Store applications: mas not found.'
    fi
}

update_packages() {
    local target=${1:-all}
    local profile

    case "$target" in
        all | system | node | rust | editors | tools) ;;
        *) fail "unknown update target: $target" ;;
    esac

    profile=$(chezmoi execute-template '{{ .profile }}')
    case "$profile" in
        pinamac | isl-server) ;;
        *) fail "unsupported chezmoi profile: $profile" ;;
    esac

    failed_updates=()
    succeeded_updates=0
    log "Updating $target (profile: $profile)..."

    if [[ "$target" == all || "$target" == system ]]; then
        case "$profile" in
            pinamac) update_pinamac_packages ;;
            isl-server) update_isl_server_packages ;;
        esac
    fi

    if [[ "$target" == all || "$target" == tools ]]; then
        update_bin_tools "$profile"
        update_pnpm_packages
        update_uv_tools
        run_update_step 'Updating hax-web' update_hax_web
    fi

    if [[ "$target" == all || "$target" == node ]]; then
        update_node
    fi

    if [[ "$target" == all ]]; then
        update_deno
    fi

    if [[ "$target" == all || "$target" == rust ]]; then
        update_rust
        update_cargo_tools
    fi

    if [[ "$target" == all || "$target" == editors ]]; then
        run_update_step 'Updating Helix' update_helix
        run_update_step 'Updating Mitos' update_mitos
    fi

    log "Update complete: $succeeded_updates succeeded, ${#failed_updates[@]} failed."
    if ((${#failed_updates[@]})); then
        printf 'dots: failed: %s\n' "${failed_updates[@]}" >&2
        return 1
    fi
}

update_themes() {
    local profile
    local data_home
    local source_dir

    profile=$(chezmoi execute-template '{{ .profile }}')
    source_dir=$(chezmoi source-path)
    data_home=${XDG_DATA_HOME:-"$HOME/.local/share"}
    catppina_dir="$data_home/catppina"

    if [[ -d "$catppina_dir/.git" ]]; then
        log 'updating Catppina themes...'
        git -C "$catppina_dir" fetch --depth=1 origin main
        git -C "$catppina_dir" reset --hard origin/main
    elif [[ -e "$catppina_dir" ]]; then
        fail "$catppina_dir exists but is not a Git checkout"
    else
        log 'cloning Catppina themes...'
        git clone --depth=1 "$catppina_repository" "$catppina_dir"
    fi

    log 'copying shared themes into chezmoi source state...'
    copy_themes <<'THEMES'
btop/catppina_dark.theme dot_config/btop/themes/catppina_dark.theme
delta/catppina_dark.gitconfig dot_config/delta/catppina_dark.gitconfig
fzf/catppina_dark.sh dot_config/fzf/themes/catppina_dark.zsh
gitui/catppina_dark.ron dot_config/gitui/theme.ron
glamour/catppina_dark.json dot_config/glow/catppina_dark.json
glamour/catppina_light.json dot_config/glow/catppina_light.json
helix/catppina_dark.toml dot_config/helix/themes/catppina_dark.toml
helix/catppina_light.toml dot_config/helix/themes/catppina_light.toml
posting/catppina_dark.yaml dot_local/share/posting/themes/catppina_dark.yaml
yazi/catppina_dark.toml dot_config/yazi/theme.toml
THEMES

    if [[ "$profile" == 'pinamac' ]]; then
        log 'copying PinaMac themes into chezmoi source state...'
        copy_themes <<'THEMES'
ghostty/catppina_dark.conf dot_config/ghostty/themes/catppina_dark
zed/catppina_dark.json dot_config/zed/themes/catppina_dark.json
zed/catppina_light.json dot_config/zed/themes/catppina_light.json
THEMES
    fi

    log 'applying updated source state...'
    chezmoi apply
}

pull_dotfiles() {
    local source_dir
    local repository
    local branch

    source_dir=$(chezmoi source-path)
    repository=$(git -C "$source_dir" rev-parse --show-toplevel)
    branch=$(git -C "$repository" symbolic-ref --quiet --short HEAD) ||
        fail 'cannot pull from a detached HEAD; switch to main first'
    [[ "$branch" == main ]] || fail 'dots pull requires the main branch'

    log 'Pulling from origin main...'
    git -C "$repository" pull --ff-only --no-rebase origin main
}

push_dotfiles() {
    local source_dir
    local repository
    local branch

    source_dir=$(chezmoi source-path)
    repository=$(git -C "$source_dir" rev-parse --show-toplevel)
    branch=$(git -C "$repository" symbolic-ref --quiet --short HEAD) ||
        fail 'cannot push from a detached HEAD; switch to main first'
    [[ "$branch" == main ]] || fail 'dots push requires the main branch'
    git -C "$repository" remote get-url origin >/dev/null

    log 'Staging all dotfile changes...'
    git -C "$repository" add --all
    if git -C "$repository" diff --cached --quiet; then
        log 'No changes to commit.'
    else
        git -C "$repository" commit -m 'chore: update'
    fi

    log 'Pushing to origin main...'
    git -C "$repository" push origin main
}

print_zsh_completions() {
    cat <<'ZSH'
_dots() {
  local -a commands

  commands=(
    'update:Update packages for the active profile'
    'theme:Manage Catppina themes'
    'apply:Apply dotfiles through chezmoi'
    'diff:Preview dotfile changes'
    'pull:Fast-forward dotfiles from origin main without applying'
    'push:Commit all dotfile changes and push to origin main'
    'completion:Generate shell completion'
    'help:Show usage'
  )

  if (( CURRENT == 2 )); then
    _describe -t commands 'dots command' commands
  else
    case $words[2] in
      update)
        (( CURRENT == 3 )) && _values 'update target' all system node rust editors tools
        ;;
      theme)
        (( CURRENT == 3 )) && _values 'theme command' update
        ;;
      completion)
        (( CURRENT == 3 )) && _values 'shell' zsh
        ;;
    esac
  fi
}

compdef _dots dots
ZSH
}

usage() {
    local profile

    profile=$(chezmoi execute-template '{{ .profile }}' 2>/dev/null) || profile='not configured'
    printf 'Usage: dots <command>\n\nActive profile: %s\n\n' "$profile"
    cat <<'USAGE'
Commands:
  update [target]           Update packages (default: all).
                           Targets: all, system, node, rust, editors, tools.
  theme update            Sync Catppina themes and apply dotfiles.
  apply                    Apply dotfiles through chezmoi.
  diff                     Preview dotfile changes.
  pull                     Fast-forward from origin main without applying dotfiles.
  push                     Commit all changes as "chore: update" and push to origin main.
  completion zsh           Generate Zsh completion.
  help                     Show this help.
USAGE
}

case "${1:-}" in
    update)
        (($# <= 2)) || fail 'usage: dots update [all|system|node|rust|editors|tools]'
        require_command chezmoi
        update_packages "${2:-all}"
        ;;
    theme)
        [[ "${2:-}" == update && $# == 2 ]] || fail 'usage: dots theme update'
        require_command chezmoi
        require_command git
        require_command install
        update_themes
        ;;
    apply | diff)
        (($# == 1)) || fail "usage: dots $1"
        require_command chezmoi
        exec chezmoi "$1"
        ;;
    pull)
        (($# == 1)) || fail 'usage: dots pull'
        require_command chezmoi
        require_command git
        pull_dotfiles
        ;;
    push)
        (($# == 1)) || fail 'usage: dots push'
        require_command chezmoi
        require_command git
        push_dotfiles
        ;;
    completion)
        [[ $# == 2 && "${2:-}" == zsh ]] || fail 'usage: dots completion zsh'
        print_zsh_completions
        ;;
    -h | --help | help | '')
        (($# <= 1)) || fail 'usage: dots help'
        usage
        ;;
    *)
        fail "unknown command: $1 (run dots help)"
        ;;
esac
