[delta "blue"]
	blame-palette = "#f7f7f8 #f1f1f2 #e9e9eb #eeeeef #e3e3e5"
	commit-decoration-style = "#9d9da2" bold box ul
	light = true
	file-decoration-style = "#9d9da2"
	file-style = "#303033"
	hunk-header-decoration-style = "#9d9da2" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#606064"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#9d9da2"
	line-numbers-minus-style = bold "#c94f55"
	line-numbers-plus-style = bold "#398460"
	line-numbers-right-style = "#9d9da2"
	line-numbers-zero-style = "#9d9da2"
	# 35% red 65% base
	minus-emph-style = bold syntax "#e7bdbf"
	# 20% red 80% base
	minus-style = syntax "#eed6d7"
	# 35% green 65% base
	plus-emph-style = bold syntax "#b5cfc3"
	# 20% green 80% base
	plus-style = syntax "#d1e0d9"
	map-styles = \
		bold purple => syntax "#c4cde6", \
		bold blue => syntax "#b3ccdb", \
		bold cyan => syntax "#b4cdda", \
		bold yellow => syntax "#d2c6ad"
	# Should match the name of the bat theme
	syntax-theme = blue
