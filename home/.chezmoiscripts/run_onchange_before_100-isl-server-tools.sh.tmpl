#!/usr/bin/env bash

set -euo pipefail

{{ template "logging.sh" . }}

if [[ "$(uname -s)" != 'Linux' ]]; then
    log_warning 'Skipping isl-server tools: this profile requires Linux.'
    exit 0
fi

local_bin="$HOME/.local/bin"
bin_manager="$local_bin/bin"
uv="$local_bin/uv"

{{ template "tools.bin.sh" . }}
{{ template "tools.uv.sh" . }}

install_bin_tools <<'BINARIES'
{{ template "isl-server.bin" . }}
BINARIES

install_uv_tools <<'UV_TOOLS'
{{ template "isl-server.uv" . }}
UV_TOOLS
