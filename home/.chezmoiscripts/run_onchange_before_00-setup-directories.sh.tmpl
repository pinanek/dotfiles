#!/bin/sh

set -eu

log() {
    printf 'chezmoi: %s\n' "$*"
}

log "setting up home directories"

mkdir -p \
    "{{ .chezmoi.homeDir }}/.config" \
    "{{ .chezmoi.homeDir }}/.local/bin" \
    "{{ .chezmoi.homeDir }}/.local/share" \
    "{{ .chezmoi.homeDir }}/.local/state"

log "home directory setup complete"
