#!/usr/bin/env bash

set -euo pipefail

{{ template "logging.sh" . }}

local_bin="$HOME/.local/bin"
uv="$local_bin/uv"
mkdir -p "$local_bin"

if [[ -x "$uv" ]]; then
    log_info 'uv is already installed.'
else
    log_info 'Installing uv...'
    curl -LsSf https://astral.sh/uv/install.sh |
        env UV_INSTALL_DIR="$local_bin" UV_NO_MODIFY_PATH=1 sh
fi

if [[ -x "$local_bin/python3" ]]; then
    log_info 'A default Python is already installed.'
else
    log_info 'Installing the latest Python as the default...'
    "$uv" python install --default
fi
