{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "json": {},
  "markdown": {},
  "yaml": {},
  "exec": {
    "cwd": "${configDir}",
    "commands": [
      {
        "command": "shfmt -i 2 --filename \"{{file_path}}\"",
        "exts": ["sh", "bash", "zsh"],
        "fileNames": [".bashrc", ".zshrc"]
      },
      {
        "command": "tombi format -",
        "exts": ["toml"]
      }
    ]
  },
  "excludes": [
    "**/*-lock.json"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.23.0.wasm",
    "https://plugins.dprint.dev/markdown-0.22.1.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    "https://plugins.dprint.dev/exec-0.7.3.json"
  ]
}
